<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MADA Flight Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        #map { height: 450px; width: 100%; border-radius: 1rem; }
        .map-card { display: none; }
    </style>
</head>
<body class="bg-slate-50 p-4 md:p-10 text-slate-800">

    <div class="max-w-6xl mx-auto">
        <header class="mb-10 text-center">
            <h1 class="text-4xl font-black text-slate-900 tracking-tighter">MADA <span class="text-blue-600">ACQUISIZIONI</span></h1>
            <p class="text-slate-500 font-medium uppercase text-xs tracking-widest mt-1">Flight Tracking System v2.3</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
                <h3 class="font-black uppercase text-sm tracking-widest text-blue-600 mb-4 text-center sm:text-left">Arrivi Aeroporto</h3>
                <form action="/search-airport" method="GET" class="flex gap-3">
                    <input type="text" name="airport_iata" placeholder="Es: PSR" required class="flex-grow p-4 bg-slate-50 border-0 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 uppercase font-bold text-sm sm:text-base">
                    <button class="bg-blue-600 text-white px-6 sm:px-8 rounded-2xl font-black hover:bg-blue-700 transition-all shadow-lg shadow-blue-100">CERCA</button>
                </form>
            </div>
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
                <h3 class="font-black uppercase text-sm tracking-widest text-emerald-600 mb-4 text-center sm:text-left">Tracciamento Volo</h3>
                <form action="/search-flight" method="GET" class="flex gap-3">
                    <input type="text" name="flight_iata" placeholder="Es: FR6411" required class="flex-grow p-4 bg-slate-50 border-0 rounded-2xl outline-none focus:ring-2 focus:ring-emerald-500 uppercase font-bold text-sm sm:text-base">
                    <button class="bg-emerald-600 text-white px-6 sm:px-8 rounded-2xl font-black hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-100">TRACCIA</button>
                </form>
            </div>
        </div>

        <div id="map-container" class="map-card mb-10 bg-white p-6 rounded-3xl shadow-xl border border-slate-200">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-xl font-black text-slate-800 uppercase tracking-tight">Live Radar</h2>
                    <p class="text-sm text-blue-600 font-bold" id="flight-title">---</p>
                </div>
                <button onclick="chiudiMappa()" class="bg-slate-100 p-2 rounded-full text-slate-400 hover:text-red-500 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div id="map"></div>
        </div>

        <% if (voli && voli.length > 0) { %>
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-slate-50 text-slate-400 text-[10px] uppercase tracking-[0.2em] font-black">
                        <tr>
                            <th class="px-6 py-5 text-left">Vettore</th>
                            <th class="px-6 py-5 text-left">Tratta</th>
                            <th class="px-6 py-5 text-center">Partenza (Sch)</th>
                            <th class="px-6 py-5 text-center">Arrivo (Sch)</th>
                            <th class="px-6 py-5 text-center">Status</th>
                            <th class="px-6 py-5 text-center">Mappa</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% 
                            function fmt(str) {
                                if (!str) return '--/-- --:--';
                                return `${str.substring(8, 10)}/${str.substring(5, 7)} ${str.substring(11, 16)}`;
                            }
                        %>
                        <% voli.forEach(function(volo) { %>
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-6 py-6">
                                    <div class="text-sm font-black text-slate-800 uppercase leading-none mb-1"><%= volo.airline ? volo.airline.name : 'N/D' %></div>
                                    <div class="text-[10px] font-mono text-blue-600 font-bold tracking-widest"><%= volo.flight ? (volo.flight.iata || volo.flight.number) : 'N/D' %></div>
                                </td>
                                <td class="px-6 py-6">
                                    <div class="flex items-center gap-2 font-bold text-xs">
                                        <span class="text-slate-500"><%= volo.departure ? volo.departure.iata : '???' %></span>
                                        <span class="text-slate-300">➔</span>
                                        <span class="text-blue-600"><%= volo.arrival ? volo.arrival.iata : '???' %></span>
                                    </div>
                                </td>
                                <td class="px-6 py-6 text-center font-mono text-xs font-bold text-slate-500">
                                    <%= fmt(volo.departure ? volo.departure.scheduled : null) %>
                                </td>
                                <td class="px-6 py-6 text-center font-mono text-sm font-black text-blue-700">
                                    <%= fmt(volo.arrival ? volo.arrival.scheduled : null) %>
                                </td>
                                <td class="px-6 py-6 text-center">
                                    <% 
                                        let bg = "bg-slate-100 text-slate-500";
                                        if(volo.flight_status === 'active') bg = "bg-green-100 text-green-700";
                                        if(volo.flight_status === 'landed') bg = "bg-blue-600 text-white shadow-md shadow-blue-100";
                                        if(volo.flight_status === 'scheduled') bg = "bg-amber-100 text-amber-700";
                                    %>
                                    <span class="px-3 py-1.5 rounded-xl text-[9px] font-black uppercase <%= bg %>">
                                        <%= volo.flight_status %>
                                    </span>
                                </td>
                                <td class="px-6 py-6 text-center">
                                    <% if (volo.live && volo.live.latitude) { %>
                                        <button onclick="attivaRadar(<%= JSON.stringify(volo) %>)" class="bg-blue-50 text-blue-600 px-5 py-2.5 rounded-2xl text-[10px] font-black hover:bg-blue-600 hover:text-white transition-all shadow-sm active:scale-95">MAPPA</button>
                                    <% } else { %>
                                        <span class="text-slate-200 text-[10px] italic font-bold">No GPS</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <p class="text-[10px] text-slate-400 mt-4 text-center mb-10 italic">Visualizzazione in ordine decrescente (i voli futuri sono in alto).</p>
        <% } %>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map, marker, routeLine;
        const AIRPORT_COORDS = { 'PSR': [42.435, 14.191], 'KUN': [54.962, 24.084], 'KRK': [50.077, 19.784], 'WAW': [52.165, 20.967], 'FCO': [41.800, 12.239] };

        function attivaRadar(volo) {
            const lat = volo.live.latitude;
            const lon = volo.live.longitude;
            const destIata = volo.arrival ? volo.arrival.iata : '';
            
            document.getElementById('map-container').style.display = 'block';
            document.getElementById('flight-title').innerText = (volo.flight.iata || volo.flight.number) + " | " + volo.departure.iata + " ➔ " + destIata;

            if (!map) {
                map = L.map('map').setView([lat, lon], 6);
                L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap &copy; CARTO'
}).addTo(map);
            } else { map.setView([lat, lon], 6); }

            if (marker) map.removeLayer(marker);
            if (routeLine) map.removeLayer(routeLine);

            marker = L.circleMarker([lat, lon], { radius: 12, fillColor: "#2563eb", color: "#fff", weight: 4, fillOpacity: 1 }).addTo(map);

            if (AIRPORT_COORDS[destIata]) {
                const destCoords = AIRPORT_COORDS[destIata];
                routeLine = L.polyline([[lat, lon], destCoords], { color: '#3b82f6', weight: 4, dashArray: '12, 12', opacity: 0.6 }).addTo(map);
            }

            document.getElementById('map-container').scrollIntoView({ behavior: 'smooth' });
        }
        function chiudiMappa() { document.getElementById('map-container').style.display = 'none'; }
    </script>
</body>
</html>